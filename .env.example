# OpenDoc backend configuration. Copy to .env (never commit it).
# Every variable maps 1:1 to a field in backend/app/config.py.

# ── App ──
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=http://localhost:5173  # comma-separated list of allowed frontend origins

# ── Database (Postgres 15+ with the pgvector extension, e.g. Neon, Railway, Supabase) ──
# postgres://, postgresql:// and postgresql+asyncpg:// are all accepted.
DATABASE_URL=postgresql://opendoc:opendoc@localhost:5432/opendoc
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ── Auth ──
JWT_SECRET_KEY=change-me-to-a-random-64-char-string   # required (32+ chars) when APP_ENV=production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Object storage ──
STORAGE_BACKEND=local               # local | s3
LOCAL_STORAGE_DIR=./data/objects    # local driver only (ephemeral on most hosts)
# S3-compatible (Cloudflare R2, Railway bucket, AWS S3, MinIO, GCS interoperability):
S3_BUCKET=
S3_ENDPOINT_URL=                    # e.g. https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=20

# ── Embeddings ──
EMBEDDING_PROVIDER=fastembed        # fastembed (local ONNX, no key) | gemini
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384                   # must match the model; changing it needs a new migration + re-ingest
EMBEDDING_BATCH_SIZE=4              # small batches keep peak RSS low (see docs/BENCHMARKS.md)
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
ONNX_THREADS=2
ONNX_MEM_ARENA=false
FASTEMBED_CACHE_DIR=                # the Docker image bakes models into /opt/models
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── Reranker ──
RERANKER_PROVIDER=fastembed         # fastembed | none  (none saves ~140 MB RAM and ~0.9 s/query)
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# ── LLM (Groq primary, Gemini fallback if its key is set) ──
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1

# ── Chunking ──
CHILD_TARGET_TOKENS=300
CHILD_OVERLAP_TOKENS=50
CHILD_MIN_TOKENS=40
SECTION_MIN_TOKENS=15
PARENT_MAX_TOKENS=1200

# ── Retrieval ──
RETRIEVAL_CANDIDATES=30             # per retriever (dense and sparse) before fusion
RERANK_CANDIDATES=12
RERANK_PASSAGE_WORDS=160
CONTEXT_TOP_K=6
RRF_K=60
MIN_RERANK_SCORE=-9.0               # abstain below this top cross-encoder score
MIN_DENSE_SCORE=0.50                # abstain below this top cosine (used when RERANKER_PROVIDER=none)
MAX_CONTEXT_TOKENS=3500
HISTORY_TURNS=6

# ── Ingestion worker (in-process, Postgres-backed queue) ──
WORKER_ENABLED=true
WORKER_CONCURRENCY=1
WORKER_POLL_SECONDS=5
WORKER_MAX_ATTEMPTS=3
WORKER_STALE_MINUTES=15
WARM_MODELS_ON_STARTUP=false        # true trades ~270 MB idle RSS for no first-request model load

# ── Rate limits (per user, or per IP when unauthenticated; per instance) ──
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_QUERY=30/minute
RATE_LIMIT_UPLOAD=30/hour

# ── Advanced (defaults are fine; listed so every Settings field appears here) ──
APP_NAME="OpenDoc API"
APP_VERSION=2.0.0
DB_ECHO=false                       # log every SQL statement
EMBEDDING_CACHE_SIZE=512            # per-process LRU of query embeddings
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
SUMMARY_MAX_SECTIONS=12             # sections sampled across the selected documents for summary-type questions

# ── Container-only (read by backend/start.sh and the Dockerfile, not by Settings) ──
# PORT=8000                         # set automatically by Railway / Cloud Run / Render
# WEB_CONCURRENCY=1                 # uvicorn workers; keep 1 (each worker loads its own models)
# RUN_MIGRATIONS=true               # run `alembic upgrade head` on container start
# MALLOC_ARENA_MAX=2                # set in the image; caps glibc arenas to keep RSS down
